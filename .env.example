# Telegram API credentials
# Get these from https://my.telegram.org/apps
API_ID=your_api_id
API_HASH=your_api_hash

# Posting interval range in milliseconds.
# A random wait between MIN and MAX is picked before every post.
# (e.g., 60000 = 1 minute, 300000 = 5 minutes)
POST_INTERVAL_MIN_MS=60000
POST_INTERVAL_MAX_MS=300000

# Automatic account standing check via @SpamBot
SPAMBOT_CHECK_ENABLED=true
# Check runs at startup, then after this many sent posts
SPAMBOT_CHECK_EVERY_POSTS=15
# If SpamBot doesn't report "no limits", posting pauses.
# If SpamBot says "limited until <date>", it rechecks at that time;
# otherwise it rechecks after this delay (default: 1800000 = 30m)
SPAMBOT_RECHECK_DELAY_MS=1800000
